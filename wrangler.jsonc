{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hire-excellence",
  // Wraps vinext's handler: adds the realtime WebSocket route, the queue consumer, and exports the FeedHub Durable Object
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "not_found_handling": "none", "binding": "ASSETS" },
  // Pages make several sequential D1 queries; run the Worker next to the database instead of next to the visitor
  "placement": { "mode": "smart" },
  // Deployment id: part of the landing page's edge-cache key (worker/index.ts)
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  // Cloudflare creates the DNS record and certificate for this on deploy
  "routes": [{ "pattern": "hire-excellence.n1m35h.in", "custom_domain": true }],
  // Links in emails are built from this, never from request headers (a client controls those)
  // TURNSTILE_HOSTNAMES: hostnames siteverify must report for the "Verify you are human" gate (never localhost here)
  "vars": {
    "APP_URL": "https://hire-excellence.n1m35h.in",
    "TURNSTILE_SITEKEY": "0x4AAAAAAFKgly4uoUxya8AM",
    "TURNSTILE_HOSTNAMES": "hire-excellence.n1m35h.in",
    // PostHog project key: public by design (the browser bundle carries it too), it can only send events
    "POSTHOG_KEY": "phc_rTtErsBvXcrQRyKTx4KWsFNZjoZX74twxaqLNMbUK8Rv",
    "POSTHOG_HOST": "https://us.i.posthog.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hire-excellence-db",
      "database_id": "80ba1497-4549-4f52-9171-ba69fb4ca2bc",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "hire-excellence-media" }],
  // Read-mostly cache (lib/profile.ts: the signed-in member's Clerk fields). Free tier allows ~1k writes/day: never write per request.
  "kv_namespaces": [{ "binding": "CACHE", "id": "129f69d9798e4a38a7c9e2d36d9ee34e" }],
  "durable_objects": { "bindings": [{ "name": "FEED_HUB", "class_name": "FeedHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FeedHub"] }],
  // Background work (lib/tasks.ts): AI grading, invite emails, notification fan-out. Retried with backoff, then parked in the DLQ.
  "queues": {
    "producers": [{ "binding": "TASKS", "queue": "hire-excellence-tasks" }],
    "consumers": [
      {
        "queue": "hire-excellence-tasks",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "retry_delay": 30,
        "dead_letter_queue": "hire-excellence-tasks-dlq"
      },
      // Logs what landed in the DLQ (worker/index.ts queue), so failures are visible instead of expiring unseen
      { "queue": "hire-excellence-tasks-dlq", "max_batch_size": 10, "max_batch_timeout": 5 }
    ]
  },
  // Per-user write throttle (posts, uploads, likes, comments...)
  // AI_LIMIT: Bedrock calls (resume reading, MCQ drafting) cost money per call, so a much tighter cap on top of WRITE_LIMIT
  "ratelimits": [
    { "name": "WRITE_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "AI_LIMIT", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  // Every 15 minutes (worker/index.ts scheduled): close expired interviews, fail stuck gradings, sync the Clerk directory
  "triggers": { "crons": ["*/15 * * * *"] }
  // Secrets (not in this file): CLERK_SECRET_KEY, BEDROCK_*, RESEND_API_KEY, MAIL_FROM, CLERK_WEBHOOK_SECRET, LIVEKIT_*, INTERVIEW_AGENT_SECRET, TURNSTILE_SECRET via `wrangler secret`, .env.local locally
}
