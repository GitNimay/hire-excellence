{
  "name": "hire-excelence-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler d1 migrations apply hire-excellence-db --remote && wrangler deploy",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply hire-excellence-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply hire-excellence-db --remote",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "eval": "vitest run --config vitest.eval.config.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.26.4",
    "@clerk/nextjs": "^7.9.22",
    "@excalidraw/excalidraw": "^0.18.1",
    "@monaco-editor/react": "^4.7.0",
    "clsx": "^2.1.1",
    "fflate": "0.8.3",
    "gsap": "^3.15.0",
    "input-otp": "^1.5.0",
    "livekit-client": "^2.23.0",
    "lucide-react": "^1.64.0",
    "motion": "^14.8.0",
    "next": "16.4.3",
    "pdf-lib": "^1.17.1",
    "posthog-js": "^1.442.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "thinking-orbs": "^0.3.2",
    "unpdf": "^1.9.1",
    "vinext": "^1.4.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.35",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.148.0"
  },
  "type": "module",
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260926.1": true,
    "workerd@1.20261006.1": true
  },
  "overrides": {
    "source-map-js": "1.2.2",
    "fflate": "0.8.3",
    "undici": "7.30.1",
    "dompurify": "3.4.17",
    "minimatch@^10": "11.0.3",
    "lodash-es": "4.18.1",
    "nanoid@<3.3.18": "3.3.20",
    "nanoid@^4": "5.1.16",
    "katex": "0.18.11"
  }
}
