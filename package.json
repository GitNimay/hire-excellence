    "livekit-client": "^2.22.3",
    "lucide-react": "^1.52.0",
    "motion": "^13.4.6",
    "next": "16.3.7",
    "pdf-lib": "^1.17.1",
    "posthog-js": "^1.438.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "tailwind-merge": "^3.7.0",
    "thinking-orbs": "^0.3.2",
    "unpdf": "^1.8.1",
    "vinext": "^1.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.1",
    "wrangler": "^4.148.0"
