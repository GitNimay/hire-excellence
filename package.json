{
  "name": "hire-excelence-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler d1 migrations apply hire-excellence-db --remote && wrangler deploy",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --experimental-strip-types lib/rank.test.ts && node --experimental-strip-types lib/job-fields.test.ts && node --experimental-strip-types lib/notification-format.test.ts && node --experimental-strip-types lib/profile-fields.test.ts && node --experimental-strip-types lib/media.test.ts && node --experimental-strip-types lib/resume-fields.test.ts && node --experimental-strip-types lib/interview-fields.test.ts && node --experimental-strip-types lib/company-fields.test.ts && node --experimental-strip-types lib/prose.test.ts",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply hire-excellence-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply hire-excellence-db --remote"
  },
  "dependencies": {
    "@clerk/backend": "^3.21.0",
    "@clerk/nextjs": "^7.9.8",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
